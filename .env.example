# Integram MCP Server — environment variables

# Base URL of the Integram backend (default: http://localhost:8081)
INTEGRAM_URL=http://localhost:8081

# Login credentials for the Integram account
INTEGRAM_EMAIL=user@example.com
INTEGRAM_PASSWORD=your-password

# Default workspace slug to connect to on startup (optional)
# Can be changed at runtime via switch_workspace tool
INTEGRAM_WORKSPACE=my-workspace

# Set to "true" to skip HITL confirmation prompts — all destructive operations
# (create_table, delete_table, etc.) will be auto-confirmed without asking the user.
# Use only in automated/scripted contexts, not interactive sessions.
INTEGRAM_SKIP_HITL=false
